# Включаем mod_rewrite
RewriteEngine On

# Add inside the site's existing .htaccess (do not overwrite existing rewrite rules).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # HSTS intentionally omitted. Enable only after confirming HTTPS for the domain/subdomains with hosting support.
</IfModule>

# Prevent direct web access to dotfiles and common secret/config files.
<FilesMatch "^(\.env|\.user\.ini|.*\.(bak|backup|sql|dump|log))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Для API доступен и прямой URL /api/1c/v1/stocks.php.
RewriteRule ^api/1c/v1/stocks/?$ api/1c/v1/stocks.php [END,QSA]

# Старый адрес каталога перенаправляем на главную сайта.
# Работают оба варианта: /catalog и /catalog/
RewriteRule ^catalog/?$ / [R=301,L]

# Запрещаем доступ к скрытым файлам
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Кодировка по умолчанию
AddDefaultCharset UTF-8

# Запрет доступа к конфигам
<FilesMatch "\.(sql|md|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>