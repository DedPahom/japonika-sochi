# Включаем mod_rewrite
RewriteEngine On

# Старый адрес каталога перенаправляем на главную сайта.
# Работают оба варианта: /catalog и /catalog/
RewriteRule ^catalog/?$ / [R=301,L]

# Запрещаем доступ к скрытым файлам
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Кодировка по умолчанию
AddDefaultCharset UTF-8

# Запрет доступа к конфигам
<FilesMatch "\.(sql|md|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>